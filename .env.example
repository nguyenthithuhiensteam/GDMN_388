# Sao chép thành .env (KHÔNG commit .env). Mọi giá trị dưới đây là ví dụ.
DJANGO_ENV=production                 # development | testing | production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai
DJANGO_ALLOWED_HOSTS=mamnon-ten-truong.edu.vn,www.mamnon-ten-truong.edu.vn
DJANGO_CSRF_TRUSTED_ORIGINS=https://mamnon-ten-truong.edu.vn,https://www.mamnon-ten-truong.edu.vn
DJANGO_ADMIN_EMAILS=

# Cơ sở dữ liệu (chính thức: PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=mamnon
DB_USER=mamnon
DB_PASSWORD=mat-khau-csdl-manh
DB_HOST=127.0.0.1
DB_PORT=5432

# Thư mục dữ liệu
STATIC_ROOT=/srv/mamnon/staticfiles
MEDIA_ROOT=/srv/mamnon/media
PROTECTED_MEDIA_ROOT=/srv/mamnon/protected_media
PROTECTED_MEDIA_ACCEL_PREFIX=/_protected/
BACKUP_DIR=/srv/mamnon/backups
BACKUP_KEEP=14
LOG_DIR=/srv/mamnon/logs
MAX_UPLOAD_MB=20
MAX_IMAGE_MB=8

# Chạy sau Nginx: tin header X-Real-IP do Nginx đặt
TRUST_X_REAL_IP=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Đăng nhập
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_COOKIE_AGE=28800

# Email (khôi phục mật khẩu, nhắc việc)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@mamnon-ten-truong.edu.vn
EMAIL_NOTIFICATIONS_ENABLED=False

# AI hỗ trợ (tùy chọn, mặc định tắt)
AI_ENABLED=False
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_ALLOW_INTERNAL_DOCUMENTS=False

# Lưu giữ dữ liệu (ngày)
RETENTION_LOGIN_DAYS=180
RETENTION_NOTIFICATION_DAYS=180
RETENTION_CONTACT_DAYS=730
RETENTION_AUDIT_DAYS=1825
